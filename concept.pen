            {
              "type": "text",
              "id": "ioTAn",
              "name": "Lead",
              "fill": "$color-text-secondary",
              "textGrowth": "fixed-width",
              "width": 960,
              "content": "Three shared parts for adding what a business already sells to a request, quote or job. Approved by Jafar 2026-10-20: the search list is B with D's picture cards for items that have a photo; the new-item pop-up is the new concept C; the Price book drawer is B with A's Product or Service tag on every row. Products are pink with a package, services green with a wrench.",
              "lineHeight": 1.45,
              "fontFamily": "$font-family",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "h97YqR",
          "name": "Search list under a line's name",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 16,
          "children": [
            {
              "type": "frame",
              "id": "WVmzd",
              "name": "Heading",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 4,
              "children": [
                {
                  "type": "text",
                  "id": "VdUYc",
                  "name": "Title",
                  "fill": "$color-heading",
                  "content": "Search list under a line's name",
                  "fontFamily": "$font-family",
                  "fontSize": 22,
                  "fontWeight": "700",
                  "letterSpacing": -0.3
                },
                {
                  "type": "text",
                  "id": "fLVH1",
                  "name": "Desc",
                  "fill": "$color-text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 960,
                  "content": "Opens when someone types in a line's name on a request, quote or job. Picking an item fills the line from the price book; typing on without picking makes a one-off line, which is always fine. Products are listed before services, in name order. A business with no price book access just types.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-family",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
