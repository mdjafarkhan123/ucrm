              "fontFamily": "$font-family",
              "fontSize": "$font-size-larger",
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "bx9Q7",
              "name": "Note",
              "fill": "$color-text-secondary",
              "textGrowth": "fixed-width",
              "width": 1200,
              "content": "A new concept. A dark green banner says at a glance whether Messenger is on and which Facebook account is logged in. Below, every Page is one row in a single list (picture, status, last message, default star, ⋯), which stays tidy when a business has many Pages. On the right, a live test panel listens while you message your Page and shows your message landing, like watching a chat. A small \"Good to know\" card explains Meta's 24-hour rule.",
              "lineHeight": 1.5,
              "fontFamily": "$font-family",
              "fontSize": "$font-size-base",
              "fontWeight": "normal"
