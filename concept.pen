      "fill": "$color-surface-background",
      "layout": "vertical",
      "gap": 48,
      "padding": 64,
      "children": [
        {
          "type": "frame",
          "id": "U9f5n",
          "name": "Intro",
          "width": "fill_container",
          "layout": "vertical",
