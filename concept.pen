            },
            {
              "type": "text",
              "id": "n7zee",
              "name": "Lead",
              "fill": "$color-text-secondary",
              "textGrowth": "fixed-width",
              "width": 1200,
              "content": "Approved 2026-10-20: A · Timeline. The history of a client, request or quote in the page's 360 side column (Client history opens it). One thin line joins round markers in each event's colour (quote pink, client taupe, review gold, notes teal, tags and files grey); small day labels break the line; the summary reads first, who and when (“2h ago”) under it. Same behaviour as today: newest first, grouped by day, a teammate, You, The client or Automatic. Only the look changes.",
              "lineHeight": 1.45,
              "fontFamily": "$font-family",
              "fontSize": "$font-size-large",
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "Y0wjD",
              "name": "Note",
              "fill": "$color-text-secondary",
              "textGrowth": "fixed-width",
              "width": 1200,
              "content": "Loading uses row-shaped placeholders (a round marker and two lines); “Nothing yet” keeps today's words; “Couldn't load” uses the app's standard error look with a Try again button (today it shows only the error words).",
              "lineHeight": 1.45,
              "fontFamily": "$font-family",
              "fontSize": "$font-size-base",
              "fontWeight": "normal"
            }
          ]
        },
