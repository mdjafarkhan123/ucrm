        "mode": "light"
      },
      "width": 1440,
      "fill": "$color-surface-background",
      "layout": "vertical",
      "gap": 48,
      "padding": 64,
      "children": [
        {
          "type": "frame",
          "id": "U9f5n",
          "name": "Intro",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "aVjsU",
              "name": "Eyebrow",
              "fill": "$color-interactive",
              "content": "NEW CONCEPT · FOUNDATION · BATCH 11 · APPROVED 2026-10-20",
              "fontFamily": "$font-family",
              "fontSize": 12,
              "fontWeight": "600",
              "letterSpacing": 1
            },
            {
              "type": "text",
              "id": "tTlgq",
              "name": "Title",
              "fill": "$color-heading",
              "content": "Add files, photo labels and photo details",
              "fontFamily": "$font-family",
              "fontSize": 36,
              "fontWeight": "700",
              "letterSpacing": -0.8
            },
            {
              "type": "text",
              "id": "BrHNX",
              "name": "Lead",
              "fill": "$color-text-secondary",
              "textGrowth": "fixed-width",
              "width": 960,
              "content": "The last three file parts. Add files picks files already in the library and puts them on a request, quote, job or invoice without uploading them again. Photo labels is the business's one list of labels, like Before, After or Damage. Photo details is the caption and labels on one photo. Approved by Jafar 2026-10-20: Add files B (places down the side, picked files in a tray), Photo labels A (improved live look), Photo details B (caption card with a save strip). Everything they do today stays; nothing new is added.",
              "lineHeight": 1.45,
              "fontFamily": "$font-family",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "F2Dft",
          "name": "Add files",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 16,
          "children": [
            {
              "type": "frame",
              "id": "uIWeW",
              "name": "Heading",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 4,
              "children": [
                {
                  "type": "text",
                  "id": "NrKuh",
                  "name": "Title",
                  "fill": "$color-heading",
                  "content": "Add files",
                  "fontFamily": "$font-family",
                  "fontSize": 22,
                  "fontWeight": "700",
                  "letterSpacing": -0.3
                },
                {
                  "type": "text",
                  "id": "um82X",
                  "name": "Desc",
                  "fill": "$color-text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 960,
                  "content": "Opened from Add on a record's files card. It looks on this record first, then the customer, then the library: Recent, Photos, Documents, All files. Only files that passed the safety check show. A file already on the record reads Already added and cannot be picked twice. People who may change the record can also upload here. The message composer uses the same pop-up as Attach a file, without the record place or Upload.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-family",
                  "fontSize": 14,
                  "fontWeight": "normal"
