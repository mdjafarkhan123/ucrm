                      "type": "text",
                      "id": "b4zLg",
                      "name": "Rule",
                      "fill": "$color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "•  The spinner takes the icon's place; the label and the button's colour stay, so you still know what is happening. It appears the moment the button is pressed.",
                      "fontFamily": "$font-family",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "jCahX",
                      "name": "Rule",
                      "fill": "$color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "•  A button with no icon swaps its label for a centred spinner, so its width never jumps.",
                      "fontFamily": "$font-family",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Tl9xe",
                      "name": "Rule",
                      "fill": "$color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "•  While it spins, the button can't be pressed again. Screen readers hear that it is busy.",
                      "fontFamily": "$font-family",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "fxSdM",
                      "name": "Rule",
                      "fill": "$color-text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "•  Buttons that open a dialog or another page act instantly. A More menu spins only while its options load.",
                      "fontFamily": "$font-family",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
