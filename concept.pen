            {
              "type": "text",
              "id": "o5BmC3",
              "name": "Lead",
              "fill": "$color-text-secondary",
              "textGrowth": "fixed-width",
              "width": 960,
              "content": "The work timer a crew member starts on a visit or an assessment: the ticking time, the running clock, Start and Stop, and the panel that says the timer is already running on another job. Approved by Jafar 2026-10-20. Everything they do today stays (one timer at a time, amber after 12 hours, Start pauses the day clock); nothing new is added.",
              "lineHeight": 1.45,
              "fontFamily": "$font-family",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
