                              "name": "Body",
                              "fill": "$color-text-secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Built-in stages follow real work — a request coming in, an assessment being booked, a quote being sent — so they cannot be renamed, moved, or removed. Removing one of your own stages asks where its cards go first. Switch on “On hold stage” for a column like “Waiting till spring”: cards there stay open and are never counted as lost. “Warn after” is how many days a card in that stage can go without real progress — a customer reply, a booked visit, a quote sent, or a finished task — before it is marked as needing attention.",
                              "lineHeight": 1.55,
                              "fontFamily": "Inter",
                              "fontSize": 12,
                              "fontWeight": "500"
                            }
