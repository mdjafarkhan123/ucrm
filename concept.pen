    {
      "type": "frame",
      "id": "yyWfm",
      "x": 6736,
      "y": 34082,
      "name": "Concept · Batch 66 · Website chat widget · Approved B · 2026-10-22",
      "width": 1536,
      "fill": "$color-surface-background",
      "layout": "vertical",
      "gap": 48,
      "padding": 48,
      "children": [
        {
          "type": "frame",
          "id": "qIgHa",
          "name": "Intro",
          "width": 1440,
          "layout": "vertical",
          "gap": 12,
          "children": [
            {
              "type": "text",
              "id": "MtDVn",
              "name": "Eyebrow",
              "fill": "$color-interactive",
              "content": "BATCH 66 · WHAT VISITORS SEE · WEBSITE CHAT WIDGET · APPROVED B (WELCOME CARD) BY JAFAR · 2026-10-22 · BUILT 2026-10-22",
              "fontFamily": "$font-family",
              "fontSize": "$font-size-overline",
              "fontWeight": "700",
              "letterSpacing": 0.8
            },
            {
              "type": "text",
              "id": "akPba",
              "name": "Title",
              "fill": "$color-heading",
              "content": "Website chat: the chat box a visitor opens on the contractor's own website",
              "fontFamily": "$font-family",
              "fontSize": "$font-size-largest",
              "fontWeight": "700",
              "letterSpacing": -0.5
            },
            {
              "type": "text",
              "id": "mjUhn",
              "name": "Lead",
              "fill": "$color-text-secondary",
              "textGrowth": "fixed-width",
              "width": 1200,
              "content": "Pasted onto the contractor's website, it greets visitors, asks who they are, and turns into a two-way chat that lands in the Inbox. It wears the business's own logo and brand colour (from Branding), never Uplift's green, and keeps its light colours on every website. It keeps everything the live widget does: the teaser and button, name, phone with country, email and message, the 'Text me about my request' agreement, privacy link, the chat with sending and 'Not sent, tap to retry', earlier messages, the ended chat with 'Start a new conversation', and the not-set-up message. Research: Intercom Messenger, HighLevel chat widget, Podium Webchat, Zendesk messaging. This is the final drawing; the live widget and the Settings preview are built from it.",
              "lineHeight": 1.5,
              "fontFamily": "$font-family",
              "fontSize": "$font-size-base",
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "bxJHG",
          "name": "Option B · Welcome card",
          "width": 1440,
          "layout": "vertical",
