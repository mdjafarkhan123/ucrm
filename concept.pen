              "type": "frame",
              "id": "WbFWR",
              "name": "Heading",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "w7EGaU",
                  "name": "Title",
                  "fill": "$color-heading",
                  "content": "Part 1 · Approved B",
                  "fontFamily": "$font-family",
                  "fontSize": "$font-size-largest",
                  "fontWeight": "700",
                  "letterSpacing": -0.4
                },
                {
                  "type": "text",
                  "id": "CumiA",
                  "name": "Desc",
                  "fill": "$color-text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Drawn twice: a one-off job's visit (Kitchen cabinet install), and a visit on a recurring lawn-care job billed per visit, which adds the blue this-visit-only note, the Recurring pill and What this visit bills.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-family",
                  "fontSize": "$font-size-base",
                  "fontWeight": "normal"
