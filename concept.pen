            {
              "type": "text",
              "id": "vCgLE",
              "name": "Lead",
              "fill": "$color-text-secondary",
              "textGrowth": "fixed-width",
              "width": 1400,
              "content": "Approved by Jafar 2026-10-21: A · Shaped like the page (B, what is known shows first, deleted). layout/RouteSkeleton: what fills the page when you click to another page and its screen takes longer than a tenth of a second to arrive. Grey shimmering shapes take the layout of the page you are going to, so nothing jumps when it arrives: a list page shows its header, number cards and table rows; a record page shows the breadcrumb, the record header card, its sections and the side column. Same behaviour as today: shown after 0.1 s, the sidebar and top bar stay, screen readers hear \"Loading page\".",
              "lineHeight": 1.45,
              "fontFamily": "$font-family",
              "fontSize": "$font-size-large",
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "iIsPB",
          "name": "Option A · Shaped like the page",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 24,
          "children": [
            {
