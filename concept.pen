              "type": "text",
              "id": "vO5uv",
              "name": "Key title",
              "fill": "$color-heading",
              "content": "What each colour means",
              "fontFamily": "$font-family",
              "fontSize": "$font-size-larger",
              "fontWeight": "700"
            },
            {
              "type": "frame",
              "id": "cSLDj",
              "name": "Key strip",
              "fill": {
                "type": "gradient",
                "gradientType": "linear",
                "enabled": true,
                "rotation": -110,
                "size": {
                  "height": 1
                },
                "colors": [
                  {
                    "color": "$color-money-start",
                    "position": 0
                  },
                  {
                    "color": "$color-money-end",
                    "position": 1
