              "gap": 4,
              "children": [
                {
                  "type": "text",
                  "id": "ILsFU",
                  "name": "Title",
                  "fill": "$color-heading",
                  "content": "Part 2 · Date range chip",
                  "lineHeight": 1.21,
                  "fontFamily": "$font-family",
                  "fontSize": "$font-size-larger",
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "AX6Si",
                  "name": "Desc",
                  "fill": "$color-text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "DateRangeChip.svelte · the “Created” chip on Requests, Quotes, Jobs and Invoices. Resting it reads “Any time”; a set range shows its dates and a ×. Opening it shows a From box and a To box, then Clear dates and Done.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-family",
                  "fontSize": "$font-size-base",
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "W2k9cg",
              "name": "Panel",
              "width": "fill_container",
              "fill": "$color-surface",
              "cornerRadius": "$radius-large",
              "stroke": "$color-border",
              "strokeWidth": 1,
              "gap": 48,
              "padding": 32,
              "children": [
                {
                  "type": "frame",
                  "id": "f8ifn",
                  "name": "Option B",
                  "width": 860,
                  "layout": "vertical",
                  "gap": 20,
                  "children": [
                    {
                      "type": "frame",
                      "id": "DbveO",
                      "name": "Label",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 4,
                      "children": [
                        {
                          "type": "text",
                          "id": "pZrct",
                          "name": "Option",
                          "fill": "$color-heading",
                          "content": "B · The date box's time tile on the chip, From → To side by side",
                          "lineHeight": 1.21,
                          "fontFamily": "$font-family",
                          "fontSize": "$font-size-large",
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "cpnEQ",
                          "name": "Why",
                          "fill": "$color-text-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Refines the approved Filter chip in one place, said plainly: the plain calendar icon becomes the 24 time tile the approved date box already uses, so dates read as dates (time colour) across the toolbar. The panel is wider (440) with Created from → Created to on one line, so the range reads left to right like a sentence; Clear dates is a quiet link at the left, Done the main button.",
