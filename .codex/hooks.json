{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "apply_patch|Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$(git rev-parse --show-toplevel)/scripts/format-edited-files.py\"",
						"timeout": 30,
						"statusMessage": "Tidying edited files"
					}
				]
			}
		]
	}
}
