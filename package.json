{
	"name": "ucrm",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"db:types": "npx supabase gen types typescript --project-id lgerqoeyusspmgzecwjs --schema public > src/lib/database.types.ts",
		"db:migrations": "npx supabase migration list"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22",
		"@types/sanitize-html": "^2.16.1",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sass": "^1.102.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1111.0",
		"@aws-sdk/s3-request-presigner": "^3.1111.0",
		"@internationalized/date": "^3.12.3",
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.112.2",
		"@tabler/icons": "^3.46.0",
		"@tanstack/svelte-query": "^6.1.38",
		"bcryptjs": "^3.0.3",
		"bits-ui": "^2.18.1",
		"country-state-city": "^3.2.1",
		"sanitize-html": "^2.17.7",
		"svelte-dnd-action": "^0.9.78",
		"zod": "^4.4.3"
	}
}
