# Copy this file to .env for local development.
# Never commit .env or replace these placeholders with real credentials here.

# Browser-safe Supabase configuration (required)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only owner and privileged database configuration (required)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD_HASH=your-bcrypt-password-hash
SESSION_SECRET=replace-with-a-long-random-secret

# Bearer secret for the internal daily closure-cron route (required). Must match the
# `closure_cron_secret` value stored in Supabase Vault -- pg_cron's net.http_post call sends it
# as the Authorization header, since a scheduled job has no owner session to authenticate with.
CLOSURE_CRON_SECRET=replace-with-a-long-random-secret
TEAM_INVITATION_WORKER_SECRET=replace-with-a-separate-32-character-random-secret
TEAM_MEMBER_IDENTITY_WORKER_SECRET=replace-with-a-separate-32-character-random-secret

# Application URLs (reserved for integrations and deployment configuration)
APP_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Platform email (Brevo sends only platform/Jafar emails; not required by application startup)
BREVO_API_KEY=your-brevo-api-key
COMMUNICATIONS_WORKER_SECRET=your-communications-worker-secret-at-least-32-characters
SYSTEM_FROM_EMAIL=system@example.com

# Amazon SES (reserved; only Marketing identity provisioning and the Marketing sender/event consumer need
# these -- the app still boots without them). IAM user must have SES send access plus SQS
# ReceiveMessage/DeleteMessage/GetQueueAttributes scoped to the ucrm-ses-events queue only.
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=your-ses-iam-user-access-key-id
AWS_SES_SECRET_ACCESS_KEY=your-ses-iam-user-secret-access-key
AWS_SES_EVENT_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:ucrm-ses-events
# Marketing branded click links (optional; one-time shared CloudFront setup per AWS account, see
# docs/research/ses-branded-click-tracking-domain-2026-09-24.md). Leave unset to keep Amazon's default links.
AWS_CLICK_DISTRIBUTION_ID=E0000000000000
AWS_CLICK_CONNECTION_GROUP_ID=cg_000000000000000000000000000
AWS_CLICK_ROUTING_ENDPOINT=d000000000000.cloudfront.net

# Cloudflare DNS (reserved; server-only, Zone Read + DNS Edit on managed zones; used by A1-D email-domain activation)
CLOUDFLARE_DNS_API_TOKEN=your-cloudflare-dns-api-token

# Cloudflare R2 (reserved; not required by the current application startup)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Twilio and messaging (reserved; not required by the current application startup)
# Platform provisioning credentials stay outside Postgres. Per-subaccount credentials are encrypted
# with the separate application keyring before storage. Generate each key as 32 random bytes in base64.
# TWILIO_AUTH_TOKEN is the master Account Auth Token -- the most sensitive secret here. It is used only to
# create a subaccount and fetch one by SID, the two calls where Twilio returns the subaccount's own Auth Token
# (it returns it to no API key). Keep it in deployment secrets only; never in Postgres, an image, or a log.
TWILIO_ACCOUNT_SID=your-main-twilio-account-sid
TWILIO_AUTH_TOKEN=your-main-twilio-account-auth-token
TWILIO_PROVISIONING_KEY_SID=your-main-account-api-key-sid
TWILIO_PROVISIONING_KEY_SECRET=your-main-account-api-key-secret
TWILIO_CREDENTIAL_KEYRING={"activeKeyId":"v1","keys":{"v1":"replace-with-a-base64-encoded-32-byte-key"}}
# Encrypts each contractor's pasted Stripe key and webhook secret. Generate with: openssl rand -base64 32
STRIPE_CREDENTIAL_KEYRING={"activeKeyId":"v1","keys":{"v1":"replace-with-a-base64-encoded-32-byte-key"}}
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
MESSENGER_GRAPH_VERSION=v-placeholder
MESSENGER_VERIFY_TOKEN=your-messenger-verify-token

# Worker and appointment infrastructure (reserved; not required by the current application startup)
DATABASE_URL=postgresql://user:password@host:5432/database
WORKER_DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://localhost:6379
WORKER_RUNTIME=local
APPOINTMENT_MANAGE_SECRET=your-appointment-management-secret

# Cloudflare Turnstile (spam check on the public /get-started application form)
# Leave both blank to skip the check in local development.
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Web push (reserved; not required by the current application startup)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CONTACT_EMAIL=mailto:owner@example.com
PUBLIC_VAPID_KEY=your-vapid-public-key
