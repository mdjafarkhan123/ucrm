                  "fontFamily": "$font-family",
                  "fontSize": 22,
                  "fontWeight": "700",
                  "letterSpacing": -0.3
                },
                {
                  "type": "text",
                  "id": "o3Y3x",
                  "name": "Desc",
                  "fill": "$color-text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 960,
                  "content": "A file shown small. Photos show as photos wherever they appear; a document shows its type so a PDF is known at a glance. While a file is still being checked, or was refused, it says so instead of showing anything. Three sizes: a grid card, a list line and the big preview in the file's details panel.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-family",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
